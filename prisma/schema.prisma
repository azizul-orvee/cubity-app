generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Client {
  id               String        @id @default(cuid())
  name             String
  phone            String
  address          String?
  email            String?
  organization     String?
  siteName         String?
  notes            String?
  nextPromisedDate DateTime?
  nextPromisedAmount Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  entries          LedgerEntry[]
}

model LedgerEntry {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type         String
  amount       Int
  date         DateTime
  method       String?
  note         String?
  promisedDate DateTime?
  promisedAmount Int?
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([date])
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  clientName    String
  clientPhone   String?
  clientAddress String?
  projectName   String?
  issueDate     DateTime
  paidAmount    Int          @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName String
  amount      Int
  sortOrder   Int     @default(0)

  @@index([invoiceId])
}

model CompanyPayment {
  id                 String   @id
  bkashNumber        String
  bankName           String
  bankBranch         String
  bankAccountName    String
  bankAccountNumber  String
  bankRoutingNumber  String?
  updatedAt          DateTime @updatedAt
}
