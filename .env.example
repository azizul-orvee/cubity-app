# Neon Postgres (Vercel Storage). Never commit real passwords.
# DATABASE_URL          = pooled URL (host contains -pooler)
# DATABASE_URL_UNPOOLED = direct URL (no pooler) — used by prisma migrate
#
# On Vercel, connecting Neon Storage injects both of these.
# DIRECT_URL still works locally if you already have that name.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"
