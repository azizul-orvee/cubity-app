# Neon Postgres (Vercel Storage). Never commit real passwords.
# DATABASE_URL = pooled URL (host contains -pooler)
# DIRECT_URL   = direct URL (no pooler) — used by prisma migrate
#
# If Neon only gave you DATABASE_URL_UNPOOLED, copy that into DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"
