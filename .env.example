# Local development uses a Homebrew Postgres database, never production.
#   brew services start postgresql@17
#   createdb cubity_dev
#   npm run db:migrate
# Replace YOUR_MAC_USER with your macOS username (`whoami`).
#
# Production Neon URLs live only in Vercel (Storage → Neon injects
# DATABASE_URL + DATABASE_URL_UNPOOLED). Never paste them here: the dev server
# and scripts/prisma-env.mjs refuse a neon.tech URL outside Vercel.
DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5432/cubity_dev"
DATABASE_URL_UNPOOLED="postgresql://YOUR_MAC_USER@localhost:5432/cubity_dev"
